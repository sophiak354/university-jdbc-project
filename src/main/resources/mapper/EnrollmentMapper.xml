<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.university.mapper.EnrollmentMapper">

    <resultMap id="EnrollmentResultMap" type="com.solvd.university.model.Enrollment">
        <id property="enrollmentId" column="enrollment_id"/>
        <result property="enrollmentDate" column="enrollment_date"/>
        <result property="enrollmentStatus" column="enrollment_status"/>
        <result property="studentId" column="student_id"/>
        <result property="offeringId" column="offering_id"/>
    </resultMap>

    <insert id="save"
            parameterType="com.solvd.university.model.Enrollment"
            useGeneratedKeys="true"
            keyProperty="enrollmentId">
        INSERT INTO Enrollment (enrollment_date, enrollment_status, student_id, offering_id)
        VALUES (#{enrollmentDate}, #{enrollmentStatus}, #{studentId}, #{offeringId})
    </insert>

    <select id="findByStudentId" parameterType="int" resultMap="EnrollmentResultMap">
        SELECT *
        FROM Enrollment
        WHERE student_id = #{studentId}
        ORDER BY enrollment_date DESC
    </select>

    <select id="existsByStudentIdAndOfferingId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM Enrollment
        WHERE student_id = #{studentId}
        AND offering_id = #{offeringId}
    </select>

</mapper>