<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.university.mapper.StudentMapper">

    <resultMap id="StudentResultMap" type="com.solvd.university.model.Student">
        <id property="studentId" column="student_id"/>
        <result property="firstName" column="first_name"/>
        <result property="lastName" column="last_name"/>
        <result property="dateOfBirth" column="date_of_birth"/>
        <result property="gender" column="gender"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="admissionDate" column="admission_date"/>
        <result property="studentStatus" column="student_status"/>
        <result property="programId" column="program_id"/>
    </resultMap>

    <select id="findById" parameterType="int" resultMap="StudentResultMap">
        SELECT *
        FROM Student
        WHERE student_id = #{id}
    </select>

    <select id="findAll" resultMap="StudentResultMap">
        SELECT *
        FROM Student
    </select>

    <insert id="save"
            parameterType="com.solvd.university.model.Student"
            useGeneratedKeys="true"
            keyProperty="studentId">
        INSERT INTO Student
        (first_name, last_name, date_of_birth, gender, email, phone, admission_date, student_status, program_id)
        VALUES
        (#{firstName}, #{lastName}, #{dateOfBirth}, #{gender}, #{email}, #{phone}, #{admissionDate}, #{studentStatus},
        #{programId})
    </insert>

    <update id="update" parameterType="com.solvd.university.model.Student">
        UPDATE Student
        SET first_name = #{firstName},
        last_name = #{lastName},
        date_of_birth = #{dateOfBirth},
        gender = #{gender},
        email = #{email},
        phone = #{phone},
        admission_date = #{admissionDate},
        student_status = #{studentStatus},
        program_id = #{programId}
        WHERE student_id = #{studentId}
    </update>

    <delete id="deleteById" parameterType="int">
        DELETE FROM Student
        WHERE student_id = #{id}
    </delete>

</mapper>